# Port the backend listens on
PORT=5000

# Default humanization intensity: light | balanced | strong
HUMANIZER_INTENSITY=balanced

# --- Ollama (local LLM) ---
# Base URL of your running Ollama instance (use 127.0.0.1, not localhost)
OLLAMA_URL=http://127.0.0.1:11434

# Model to use (must be pulled: `ollama pull llama3:8b`)
OLLAMA_MODEL=llama3:8b

# Max time to wait for a generation (ms). CPU runs can take several minutes.
OLLAMA_TIMEOUT_MS=300000

# Keep model loaded in RAM between requests (Ollama keep_alive)
OLLAMA_KEEP_ALIVE=1h

# Max output tokens (lower = faster; auto-scaled to input length)
OLLAMA_MAX_PREDICT=2048

# If Ollama is unreachable, fall back to the local algorithmic engine
# instead of returning an error. true | false
OLLAMA_FALLBACK_LOCAL=false
